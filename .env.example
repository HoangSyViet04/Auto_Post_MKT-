# Copy thành .env để ghi đè cấu hình cục bộ (dev:server, dev:worker, db:migrate tự nạp nếu có).
# Không bao giờ ghi bí mật thật (cookie, token, mật khẩu proxy, API key) vào file này.

# Môi trường: development | test | production. Mỗi môi trường một file DB riêng.
# APM_ENV=development

# Thư mục dữ liệu vận hành (DB, media, log, browser profiles).
# Mặc định: %LOCALAPPDATA%\AutoPostMKT; riêng APM_ENV=test mặc định dùng thư mục tạm của hệ điều hành.
# APM_DATA_DIR=

# Cổng server cục bộ (chỉ nghe 127.0.0.1). Vite dev proxy dùng cùng giá trị.
# APM_SERVER_PORT=4317

# Adapter tích hợp: fake (mặc định, mô phỏng, không gọi Facebook) | live (adapter thật — chưa có, P08/P09).
# live bị cấm khi APM_ENV=test.
# APM_INTEGRATIONS=fake
